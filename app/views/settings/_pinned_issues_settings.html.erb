<%
  defaults = RedminePinnedIssues::DEFAULT_COLORS
  color_pattern = '#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})'
  color_hint    = l(:text_color_format_hint)

  default_odd  = defaults['pinned_color_odd']
  default_even = defaults['pinned_color_even']
  default_imp_header = defaults['important_header_color']
  default_imp_bg     = defaults['important_bg_color']
  default_imp_border = defaults['important_border_color']

  value_odd  = settings['pinned_color_odd'].presence  || default_odd
  value_even = settings['pinned_color_even'].presence || default_even
  value_imp_header = settings['important_header_color'].presence || default_imp_header
  value_imp_bg     = settings['important_bg_color'].presence     || default_imp_bg
  value_imp_border = settings['important_border_color'].presence || default_imp_border
%>

<div class="box tabular">
  <h4><%= l(:label_pinned_settings_header) %></h4>
  <p>
    <label><%= l(:label_pinned_color_odd) %></label>
    <input type="color" id="color_picker_odd" value="<%= value_odd %>" oninput="document.getElementById('settings_pinned_color_odd').value = this.value">
    <input type="text" name="settings[pinned_color_odd]" id="settings_pinned_color_odd" 
            value="<%= value_odd %>" size="10"
            pattern="<%= color_pattern %>" title="<%= color_hint %>"
            oninput="document.getElementById('color_picker_odd').value = this.value">
    <a href="#" class="icon icon-reload" onclick="document.getElementById('settings_pinned_color_odd').value = '<%= default_odd %>'; document.getElementById('color_picker_odd').value = '<%= default_odd %>'; return false;"><%= l(:button_reset_default) %></a>
  </p>

  <p>
    <label><%= l(:label_pinned_color_even) %></label>
    <input type="color" id="color_picker_even" value="<%= value_even %>" oninput="document.getElementById('settings_pinned_color_even').value = this.value">
    <input type="text" name="settings[pinned_color_even]" id="settings_pinned_color_even" 
            value="<%= value_even %>" size="10"
            pattern="<%= color_pattern %>" title="<%= color_hint %>"
            oninput="document.getElementById('color_picker_even').value = this.value">
    <a href="#" class="icon icon-reload" onclick="document.getElementById('settings_pinned_color_even').value = '<%= default_even %>'; document.getElementById('color_picker_even').value = '<%= default_even %>'; return false;"><%= l(:button_reset_default) %></a>
  </p>
</div>

<div class="box tabular">
  <h4><%= l(:label_important_settings_header) %></h4>
  <p>
    <label><%= l(:label_important_header_color) %></label>
    <input type="color" id="color_picker_imp_header" value="<%= value_imp_header %>" oninput="document.getElementById('settings_important_header_color').value = this.value">
    <input type="text" name="settings[important_header_color]" id="settings_important_header_color" 
            value="<%= value_imp_header %>" size="10"
            pattern="<%= color_pattern %>" title="<%= color_hint %>"
            oninput="document.getElementById('color_picker_imp_header').value = this.value">
    <a href="#" class="icon icon-reload" onclick="document.getElementById('settings_important_header_color').value = '<%= default_imp_header %>'; document.getElementById('color_picker_imp_header').value = '<%= default_imp_header %>'; return false;"><%= l(:button_reset_default) %></a>
  </p>

  <p>
    <label><%= l(:label_important_bg_color) %></label>
    <input type="color" id="color_picker_imp_bg" value="<%= value_imp_bg %>" oninput="document.getElementById('settings_important_bg_color').value = this.value">
    <input type="text" name="settings[important_bg_color]" id="settings_important_bg_color" 
            value="<%= value_imp_bg %>" size="10"
            pattern="<%= color_pattern %>" title="<%= color_hint %>"
            oninput="document.getElementById('color_picker_imp_bg').value = this.value">
    <a href="#" class="icon icon-reload" onclick="document.getElementById('settings_important_bg_color').value = '<%= default_imp_bg %>'; document.getElementById('color_picker_imp_bg').value = '<%= default_imp_bg %>'; return false;"><%= l(:button_reset_default) %></a>
  </p>

  <p>
    <label><%= l(:label_important_border_color) %></label>
    <input type="color" id="color_picker_imp_border" value="<%= value_imp_border %>" oninput="document.getElementById('settings_important_border_color').value = this.value">
    <input type="text" name="settings[important_border_color]" id="settings_important_border_color" 
            value="<%= value_imp_border %>" size="10"
            pattern="<%= color_pattern %>" title="<%= color_hint %>"
            oninput="document.getElementById('color_picker_imp_border').value = this.value">
    <a href="#" class="icon icon-reload" onclick="document.getElementById('settings_important_border_color').value = '<%= default_imp_border %>'; document.getElementById('color_picker_imp_border').value = '<%= default_imp_border %>'; return false;"><%= l(:button_reset_default) %></a>
  </p>
</div>

<div class="box tabular">
  <h4><%= l(:label_issue_colors_header) %></h4>
  <p>
    <label><%= l(:label_enable_issue_colors) %></label>
    <input type="hidden" name="settings[enable_issue_colors]" value="0">
    <%= check_box_tag 'settings[enable_issue_colors]', '1', settings['enable_issue_colors'] == '1' %>
    <em class="info"><%= l(:text_issue_colors_description) %></em>
  </p>
</div>